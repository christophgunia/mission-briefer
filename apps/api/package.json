{
  "name": "@mb/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "start": "tsx --env-file=.env src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.1",
    "@fastify/jwt": "9.0.1",
    "@fastify/static": "8.0.3",
    "@mb/shared": "workspace:*",
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "fastify": "5.1.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.9.0",
    "prisma": "5.22.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
